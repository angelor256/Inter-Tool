# Proveedor de IA: "openai" (de pago) o "gemini" (con capa gratuita)
LLM_PROVIDER=gemini

# Rellena SOLO la del proveedor elegido
GEMINI_API_KEY=
OPENAI_API_KEY=

SUPABASE_URL=https://<tu-proyecto>.supabase.co
# Usa la service_role key (solo backend, NUNCA en el frontend)
SUPABASE_SERVICE_KEY=eyJ...

# Opcional: URL del webhook (Slack, n8n, Zapier...) para avisar a agentes humanos
ESCALATION_WEBHOOK_URL=

# Opcional: dominios desde los que se incrusta el widget (separados por comas)
CORS_ORIGINS=

# Opcionales (déjalas vacías para usar los valores por defecto del proveedor)
# CHAT_MODEL=              # openai: gpt-4o | gemini: gemini-2.5-flash
# EMBEDDING_MODEL=         # openai: text-embedding-3-small | gemini: gemini-embedding-001
# SIMILARITY_THRESHOLD=    # openai: 0.75 | gemini: 0.65
# ESCALATE_ON_LOW_CONFIDENCE=true
